rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Synclyx Firestore Security Rules
// ─────────────────────────────────────────────────────────────────────────
// What these rules DO:
//   - Enforce that a user can only read/write their own data
//     (users/{uid}/** — never someone else's)
//   - Validate the SHAPE of every write: required fields present, correct
//     types, and sane size caps on strings/arrays before Firestore accepts
//     the write at all
//
// What these rules do NOT do (and can't):
//   - True rate limiting (e.g. "max 20 writes per minute"). Security Rules
//     have no memory of a user's previous writes — each rule only sees the
//     one write happening right now. Real abuse-rate protection needs
//     Firebase App Check (attestation that requests come from your real
//     app, not a script) layered in front of this. Worth adding before
//     Synclyx has real paying users; not required to ship this update.
//
// Deploy with: firebase deploy --only firestore:rules
// (after `firebase login` and `firebase use synclyx-app` — see
// docs/firebase-deploy.md)
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public share links ────────────────────────────────────────────────
    // A collection-group query (what the public share page runs) is ONLY
    // authorised by a rule written with a recursive wildcard like this one.
    // Rules nested under /users/{userId}/notes/... do NOT cover it, which is
    // why share links showed "This link isn't available" even though the note
    // was public. Matching rules are OR'd: owners still get access from the
    // nested rules below, and anyone can read a doc flagged isPublic.
    match /{path=**}/notes/{noteId} {
      allow read: if resource.data.isPublic == true;
    }
    match /{path=**}/canvases/{canvasId} {
      allow read: if resource.data.isPublic == true;
    }

    match /users/{userId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // ── The profile document itself: users/{uid} ────────────────────────
      // Sign-up and Google sign-in write { uid, email, displayName, plan,
      // createdAt } here. This had no rule, so every one of those writes was
      // denied (while Firebase Auth itself still succeeded, which is why you
      // were signed in AND shown an error).
      // The client may create it as 'free' and may never change `plan` —
      // otherwise anyone could upgrade themselves to Pro from the browser
      // console. Phase 4's payment webhook will set plan server-side.
      allow read: if isOwner();
      allow create: if isOwner() && request.resource.data.plan == 'free';
      allow update: if isOwner() && request.resource.data.plan == resource.data.plan;

      // ── notes/{noteId} ──────────────────────────────────────────────────
      match /notes/{noteId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500
          && request.resource.data.blocks is list
          && request.resource.data.blocks.size() <= 500
          && request.resource.data.get('tags', []) is list
          && request.resource.data.get('pinned', false) is bool
          && request.resource.data.get('linkedNotes', []) is list
          && request.resource.data.get('versions', []) is list
          && request.resource.data.get('versions', []).size() <= 10
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      // ── notebooks/{notebookId} ──────────────────────────────────────────
      match /notebooks/{notebookId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.color is string
          && request.resource.data.createdAt is number;
      }

      // ── canvases/{canvasId} ──────────────────────────────────────────────
      match /canvases/{canvasId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.nodes is list
          && request.resource.data.nodes.size() <= 300
          && request.resource.data.edges is list
          && request.resource.data.edges.size() <= 600
          && request.resource.data.get('viewport', {}) is map
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      // ── trash/{trashId} — notes + canvases ───────────────────────────────
      match /trash/{trashId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.type in ['note', 'canvas']
          && request.resource.data.data is map
          && request.resource.data.deletedAt is number;
      }

      // ── syncboard/{itemId} — clips ───────────────────────────────────────
      match /syncboard/{itemId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 60000 // matches MAX_CLIP_LENGTH + margin
          && request.resource.data.type in ['text', 'link', 'code']
          && request.resource.data.source in ['manual', 'electron', 'mobile']
          && request.resource.data.pinned is bool
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      // ── syncboard_trash/{trashId} ─────────────────────────────────────────
      match /syncboard_trash/{trashId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.id is string
          && request.resource.data.item is map
          && request.resource.data.deletedAt is number
          && request.resource.data.expiresAt is number;
      }

      // ── meta/{docId} — customTags today; plan/tier will live here from
      // Phase 4 onward. Loosely validated since its shape will grow. ────────
      match /meta/{docId} {
        allow read, write: if isOwner();
      }

      // Anything else under this user that isn't one of the collections
      // above — deny by default rather than falling back to a permissive
      // wildcard. If a new collection is added later, its own match block
      // needs to be added here too; this is a deliberate safety choice over
      // convenience.
    }

    // No access to anything outside /users/{userId}/** for anyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
