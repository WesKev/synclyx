{
  "manifest_version": 3,
  "name": "Synclyx",
  "version": "0.1.0",
  "description": "Send selected text and links to your Synclyx feed instantly",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
